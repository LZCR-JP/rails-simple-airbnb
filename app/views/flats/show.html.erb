<div class="row g-4">
  <div class="col-lg-7">
    <% if @flat.picture_name.present? %>
      <%= image_tag @flat.picture_name, alt: @flat.name, class: "show-img" %>
    <% end %>
  </div>
  <div class="col-lg-5">
    <h1 class="fw-bold"><%= @flat.name %></h1>
    <p class="text-muted">📍 <%= @flat.address %></p>
    <p><strong>$<%= @flat.price_per_night %></strong> / night</p>
    <p>👥 Up to <%= @flat.number_of_guests %> guests</p>
    <hr>
    <p><%= @flat.description %></p>
    <%= link_to "← Back to all flats", flats_path, class: "btn btn-outline-secondary" %>
  </div>
</div>